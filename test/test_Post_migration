def Node_list_(node) : 
    query="MATCH (p:"+node+""")
WHERE exists(p.id_)
WITH p, keys(p) as pKeys
UNWIND pKeys as Key
RETURN distinct Key"""
    data = graph.run(query).to_data_frame()
    list_me= list( data["Key"] ) 
    return list_me
    


def query_node(node) :
    query="MATCH (p:"+node+""")
    WHERE exists(p.id_)
WITH p, keys(p) as pKeys
UNWIND pKeys as Key
RETURN distinct Key"""
    data = graph.run(query).to_data_frame()
    df = pd.DataFrame(columns = list( data["Key"] ))  
    query = "MATCH (p:"+node+") RETURN p"
    data = graph.run(query).to_data_frame()
    for node in data["p"]:
        df = df.append(dict(node), ignore_index=True)  
    return df  

def rel_(rel):
   gg=graph.run("MATCH p=()-[r:"+rel+"]->() RETURN count (r) as n").to_data_frame() 
   gg=gg['n'][0]
   return gg

